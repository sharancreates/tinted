# Copy to `.env.local` and fill in values from Supabase + your API.
# Without these, the app uses placeholder Supabase URLs so builds succeed — replace before shipping auth.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=

# Optional: Spline scene (.splinecode export URL) for the home hero. Unset = gradient only.
NEXT_PUBLIC_SPLINE_SCENE_URL=
